#!/bin/sh
[ -n "${ZSH_VERSION:-}" ] && emulate sh
set -eu

autoreload_revamped_self="$0"
case "${autoreload_revamped_self}" in
*/*) ;;
*) autoreload_revamped_self="$(command -v -- "${autoreload_revamped_self}")" ;;
esac
autoreload_revamped_lib="$(cd "${autoreload_revamped_self%/*}/../lib" && pwd)" || exit 1
for autoreload_revamped_inherited in $(env | sed -n -e 's/^\(REVAMPED_[A-Za-z0-9_]*\)=.*/\1/p' -e 's/^\(AUTORELOAD_REVAMPED_[A-Za-z0-9_]*_LOADED\)=.*/\1/p'); do
  case "${autoreload_revamped_inherited}" in
  REVAMPED_TEST_*) continue ;;
  *) unset "${autoreload_revamped_inherited}" ;;
  esac
done
REVAMPED_LIB="${autoreload_revamped_lib}"

# shellcheck source=SCRIPTDIR/../lib/core.sh
. "${REVAMPED_LIB}/core.sh"
# shellcheck source=SCRIPTDIR/../lib/autoreload.sh
. "${REVAMPED_LIB}/autoreload.sh"

autoreload_revamped_interface() {
  # shellcheck disable=SC2034
  REVAMPED_UI_NAME=autoreload-revamped REVAMPED_UI_VERSION="${AUTORELOAD_REVAMPED_VERSION}" REVAMPED_UI_TAGLINE="save your tmux config and it reloads itself"
  if [ -n "${AUTORELOAD_REVAMPED_ACCENT:-}" ]; then
    # shellcheck disable=SC2034
    REVAMPED_UI_ACCENT_CHOICE="${AUTORELOAD_REVAMPED_ACCENT}" REVAMPED_UI_ACCENT_NAME=AUTORELOAD_REVAMPED_ACCENT
  fi
  # shellcheck source=SCRIPTDIR/../lib/cli.sh
  . "${REVAMPED_LIB}/cli.sh"
  # shellcheck source=SCRIPTDIR/../lib/doctor.sh
  . "${REVAMPED_LIB}/doctor.sh"
}

autoreload_revamped_usage() {
  autoreload_revamped_interface
  revamped_cli_usage_error "$1"
}

autoreload_revamped_help() {
  revamped_cli_help_page <<'HELP'
autoreload-revamped - reload the tmux config when one of its files is saved

usage:
  autoreload-revamped apply     start the watcher, unless one is alive
  autoreload-revamped watch     watch the config files until the server ends
  autoreload-revamped reload    source the entry points now
  autoreload-revamped pause     stop reacting to changes
  autoreload-revamped resume    react to changes again
  autoreload-revamped toggle    switch between paused and active
  autoreload-revamped status    print the state, the watcher and its backend
  autoreload-revamped doctor    check this machine
  autoreload-revamped version   print the version
  autoreload-revamped help      print this page

options:
  --json           status prints one JSON object
  --theme NAME     the look: kodougu, catppuccin-mocha, catppuccin-latte,
                   dracula, nord, gruvbox, tokyo-night or mono
  --SETTING VALUE  any tmux option below, named with dashes, such as
                   --interval 5 or --quiet 1

environment:
  AUTORELOAD_REVAMPED_SETTING  any tmux option below in capitals, such as
                               AUTORELOAD_REVAMPED_INTERVAL
  AUTORELOAD_REVAMPED_THEME    the look, when --theme is not given
  AUTORELOAD_REVAMPED_ACCENT   a colour such as #CBA6F7 for the accent
  KODOUGU_THEME                the family look, when neither is given
  KODOUGU_ACCENT               the family accent, when the tool's is unset
  NO_COLOR                     turn colour off

tmux options:
  @autoreload_revamped_files        files to watch, in place of the ones tmux
                                    loaded (none)
  @autoreload_revamped_entrypoints  files sourced on a reload (the loaded
                                    config files)
  @autoreload_revamped_interval     seconds between checks when it polls (2)
  @autoreload_revamped_quiet        1 hides the reload message (0)
  @autoreload_revamped_discover     0 skips the files a config sources (1)
  @autoreload_revamped_atomic       0 watches the files without their
                                    folders (1)
  @autoreload_revamped_validate     0 skips sourcing the last good copy
                                    after an error (1)
  @autoreload_revamped_defer        0 reloads even while a pane is in a
                                    mode (1)
  @autoreload_revamped_selective    1 sources only the entry points that
                                    include the changed file (0)
  @autoreload_revamped_flash        1 repeats the message in reverse video (0)
  @autoreload_revamped_notify       1 sends a desktop notification (0)
  @autoreload_revamped_backup_dir   folder of the last good copies
                                    (~/.tmux/autoreload-revamped/backup)
  @revamped_theme                   the family look (kodougu)

notes:
  The entry point runs apply once when tmux loads the plugin. The watcher
  compares a checksum of every watched file, so a save that changes no byte
  reloads nothing. It waits on fswatch, inotifywait or entr when one is
  installed and polls otherwise, reads the settings again on every check, and
  ends when its tmux server does. A reload that fails shows the error once
  and sources the last good copy of the failing file. The watcher's process
  id is kept in @autoreload_revamped_pid and the pause in
  @autoreload_revamped_paused.

examples:
  autoreload-revamped status
  autoreload-revamped reload
  autoreload-revamped doctor
HELP
}

autoreload_revamped_version() {
  autoreload_revamped_tmux=$(tmux -V 2>/dev/null) || autoreload_revamped_tmux=missing
  printf '%s %s\n' autoreload-revamped "${AUTORELOAD_REVAMPED_VERSION}"
  printf 'tmux: %s\n' "${autoreload_revamped_tmux#tmux }"
}

autoreload_revamped_doctor_backend() {
  autoreload_revamped_doctor_backend_name=$(autoreload_revamped_backend)
  if [ "${autoreload_revamped_doctor_backend_name}" = poll ]; then
    revamped_doctor_line watcher warn "polling; fswatch, inotifywait or entr reloads on the save itself"
    return 0
  fi
  autoreload_revamped_doctor_backend_path=$(command -v "${autoreload_revamped_doctor_backend_name}")
  revamped_doctor_line watcher ok "${autoreload_revamped_doctor_backend_path}"
}

autoreload_revamped_doctor_settings() {
  autoreload_revamped_doctor_settings_rows=$(autoreload_revamped_setting_rows)
  # shellcheck disable=SC2154
  revamped_doctor_settings "${AUTORELOAD_REVAMPED_KINDS}" "${autoreload_revamped_doctor_settings_rows}"
}

autoreload_revamped_doctor() {
  revamped_doctor_tmux
  autoreload_revamped_doctor_backend
  revamped_doctor_notifier
  autoreload_revamped_doctor_settings
  revamped_doctor_gum
  revamped_doctor_core_tools awk sed tr cksum
  revamped_doctor_finish
  [ "${REVAMPED_DOCTOR_MISSING}" -eq 0 ] || exit 1
}

autoreload_revamped_status() {
  autoreload_revamped_status_row=$(autoreload_revamped_state)
  if [ -n "${autoreload_revamped_json}" ]; then
    printf '%s\n' "${autoreload_revamped_status_row}" | awk -F '\t' '{ printf "{\"state\":\"%s\",\"watcher\":%s,\"backend\":\"%s\"}\n", $1, ($2 == "none" ? "null" : $2), $3 }'
    return 0
  fi
  printf '%s\n' "${autoreload_revamped_status_row}" | awk -F '\t' '{ printf "autoreload-revamped: %s; watcher pid %s; backend %s\n", $1, $2, $3 }'
}

autoreload_revamped_menu() {
  revamped_cli_require_terminal
  autoreload_revamped_choice=$(revamped_cli_menu "Show the status" "Reload now" "Pause or resume" "Check this machine" "Help")
  case "${autoreload_revamped_choice}" in
  "Show the status") autoreload_revamped_status ;;
  "Reload now") autoreload_revamped_reload ;;
  "Pause or resume") autoreload_revamped_toggle ;;
  "Check this machine") autoreload_revamped_doctor ;;
  *) autoreload_revamped_help ;;
  esac
}

autoreload_revamped_dispatch() {
  case "${1:-}" in
  doctor) autoreload_revamped_doctor ;;
  version | --version | -V) autoreload_revamped_version ;;
  help | --help | -h) autoreload_revamped_help ;;
  status) autoreload_revamped_status ;;
  "") autoreload_revamped_menu ;;
  *) revamped_cli_usage_error "unknown command '$1'" ;;
  esac
}

autoreload_revamped_known() {
  [ "$1" != --theme ] || return 0
  autoreload_revamped_known_name=$(autoreload_revamped_setting_name "$1")
  [ -n "${autoreload_revamped_known_name}" ] || autoreload_revamped_usage "unknown option '$1'"
}

autoreload_revamped_option() {
  autoreload_revamped_option_name=$(autoreload_revamped_setting_name "$1")
  [ -n "${autoreload_revamped_option_name}" ] || autoreload_revamped_usage "unknown option '$1'"
  autoreload_revamped_option_upper=$(printf '%s\n' "${autoreload_revamped_option_name}" | tr '[:lower:]' '[:upper:]')
  export "AUTORELOAD_REVAMPED_${autoreload_revamped_option_upper}=$2"
}

autoreload_revamped_main() {
  autoreload_revamped_theme="${AUTORELOAD_REVAMPED_THEME:-}" autoreload_revamped_json="" autoreload_revamped_count=$# autoreload_revamped_rest=0
  while [ "${autoreload_revamped_count}" -gt 0 ]; do
    autoreload_revamped_arg="$1"
    shift
    autoreload_revamped_count=$((autoreload_revamped_count - 1))
    case "${autoreload_revamped_rest}:${autoreload_revamped_arg}" in
    1:*) set -- "$@" "${autoreload_revamped_arg}" ;;
    0:--) autoreload_revamped_rest=1 ;;
    0:--json) autoreload_revamped_json=1 ;;
    0:-h | 0:-V | 0:--help | 0:--version) set -- "$@" "${autoreload_revamped_arg}" ;;
    0:--theme=*) autoreload_revamped_theme="${autoreload_revamped_arg#--theme=}" ;;
    0:--*=*) autoreload_revamped_option "${autoreload_revamped_arg%%=*}" "${autoreload_revamped_arg#*=}" ;;
    0:--*)
      autoreload_revamped_known "${autoreload_revamped_arg}"
      [ "${autoreload_revamped_count}" -gt 0 ] || autoreload_revamped_usage "option '${autoreload_revamped_arg}' needs a value"
      if [ "${autoreload_revamped_arg}" = --theme ]; then
        autoreload_revamped_theme="$1"
      else
        autoreload_revamped_option "${autoreload_revamped_arg}" "$1"
      fi
      shift
      autoreload_revamped_count=$((autoreload_revamped_count - 1))
      ;;
    0:-?*) autoreload_revamped_usage "unknown option '${autoreload_revamped_arg}'" ;;
    *) set -- "$@" "${autoreload_revamped_arg}" ;;
    esac
  done
  autoreload_revamped_start "${autoreload_revamped_theme}" "$@"
}

autoreload_revamped_start() {
  autoreload_revamped_start_theme="$1"
  shift
  [ -z "${autoreload_revamped_json}" ] || [ "${1:-}" = status ] || autoreload_revamped_usage "option '--json' works only with status"
  case "${1:-}" in
  apply | watch | reload | toggle) "autoreload_revamped_$1" ;;
  pause) autoreload_revamped_set_paused 1 "autoreload paused" ;;
  resume) autoreload_revamped_set_paused 0 "autoreload resumed" ;;
  *)
    autoreload_revamped_interface
    revamped_cli_start "${autoreload_revamped_start_theme}"
    autoreload_revamped_dispatch "$@"
    ;;
  esac
}

autoreload_revamped_main "$@"
